# Discord Bot Token — get from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# AI Provider: "ollama" for local testing, "openai" for production
AI_PROVIDER=openai

# Ollama settings (local testing)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# OpenAI — required for vector embeddings even when AI_PROVIDER=ollama
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Bot behavior
AUTO_SASS_CHANCE=0.4
AUTO_SASS_MIN_MESSAGES=2

# Creator — Sass's bestie, never gets roasted
CREATOR_ID=your_discord_user_id_here
CLIENT_ID=your_bot_client_id_here

# PostgreSQL (Railway provides this automatically via variable reference)
# Leave blank for local dev — bot runs fine without it, just no logging
DATABASE_URL=
