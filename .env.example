# ── Required ──────────────────────────────────────────────
# Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=your_discord_bot_token_here
# Developer Portal → your app → General Information → Application ID
CLIENT_ID=your_bot_client_id_here
# Your own Discord user ID (Settings → Advanced → Developer Mode, then right-click your name → Copy User ID).
# Optional legacy owner ID for restricted administrator/test tools only.
# All users use the same personality, memory and cooldown rules.
CREATOR_ID=your_discord_user_id_here

# ── Chat model: pick one ──────────────────────────────────
# "openai" = any OpenAI-compatible API (OpenAI, OpenRouter, Groq, Together, …)
# "ollama" = local model via Ollama
AI_PROVIDER=openai

# OpenAI-compatible API for chat when AI_PROVIDER=openai.
# Vector memory uses EMBEDDING_OPENAI_* below (not these keys).
# Image roasts need a vision-capable model (here or in OLLAMA_MODEL).
OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini
# Optional combined generation ceiling. Defaults: 16384 for recognized reasoning
# models/Claude, 4096 for ordinary chat and Ollama. Must fit the selected model.
# SASS_REPLY_MAX_TOKENS=16384

# Ollama (only when AI_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Memory search (vector embeddings). Default: local model on your Mac (see npm run setup).
# SASS_EMBEDDING_PROVIDER=local
# EMBEDDING_DIMENSION=768
# LOCAL_EMBED_MODEL=onnx-community/embeddinggemma-2-ONNX
# Cloud/Ollama instead: SASS_EMBEDDING_PROVIDER=openai|ollama|off
# EMBEDDING_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_OPENAI_API_KEY=ollama

# ── Optional ──────────────────────────────────────────────
# Local Postgres (recommended for trying Sass on your laptop). npm start starts
# it automatically; data lives in .sass-data/ (gitignored). Leave enabled unless
# you use DATABASE_URL for Railway, Neon, etc.
SASS_EMBEDDED_PG=1
# Postgres connection string for hosted databases. When SASS_EMBEDDED_PG=1, npm
# start fills this at runtime; you can paste a Railway/Neon URL here instead and
# set SASS_EMBEDDED_PG=0 or remove it.
DATABASE_URL=

# Auto-sass: chance (0–1) to jump into a channel unprompted, and the channel activity threshold
AUTO_SASS_CHANCE=0.4
AUTO_SASS_MIN_MESSAGES=2
