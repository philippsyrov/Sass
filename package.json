{
  "name": "sass",
  "version": "1.0.2",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "setup": "tsx src/setup.ts",
    "invite": "node dist/invite.js",
    "assets": "tsx scripts/upload-assets.ts",
    "emoji": "tsx scripts/upload-assets.ts",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "lint": "eslint src/",
    "doctor": "node dist/doctor.js",
    "verify": "./scripts/verify.sh",
    "generate-mascot": "python3 scripts/generate-mascot-art.py",
    "migrate": "tsx src/migrate.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "ai",
    "roast"
  ],
  "author": "",
  "license": "ISC",
  "description": "Sass — a sassy AI Discord bot that roasts users",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@huggingface/transformers": "^4.3.2",
    "@types/react": "^18.3.12",
    "canvas": "^3.2.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.3.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "ollama": "^0.6.3",
    "openai": "^6.32.0",
    "pg": "^8.20.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "eslint": "^10.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
